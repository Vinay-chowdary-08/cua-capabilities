{
  "$defs": {
    "AppInfo": {
      "properties": {
        "vendor": {
          "title": "Vendor",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "compatible_versions": {
          "default": "*",
          "title": "Compatible Versions",
          "type": "string"
        }
      },
      "required": [
        "vendor",
        "product"
      ],
      "title": "AppInfo",
      "type": "object"
    },
    "CapabilityBody": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus",
          "default": "draft"
        },
        "app": {
          "$ref": "#/$defs/AppInfo"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Outputs",
          "type": "object"
        },
        "risk": {
          "$ref": "#/$defs/RiskClass",
          "default": "read_only"
        },
        "preconditions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CapabilityStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/OutcomeSpec"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "recoverables": {
          "items": {
            "$ref": "#/$defs/Recoverable"
          },
          "title": "Recoverables",
          "type": "array"
        },
        "success": {
          "items": {
            "$ref": "#/$defs/SuccessCondition"
          },
          "title": "Success",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "app"
      ],
      "title": "CapabilityBody",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "CapabilityStep": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "action": {
          "enum": [
            "click",
            "type",
            "select",
            "press",
            "extract",
            "navigate"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "extract": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ExtractField"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extract"
        },
        "expect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "any_of": "#/$defs/ExpectAnyOf",
                  "element_visible": "#/$defs/ExpectElementVisible",
                  "text_visible": "#/$defs/ExpectTextVisible",
                  "url_matches": "#/$defs/ExpectUrlMatches"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ExpectElementVisible"
                },
                {
                  "$ref": "#/$defs/ExpectTextVisible"
                },
                {
                  "$ref": "#/$defs/ExpectUrlMatches"
                },
                {
                  "$ref": "#/$defs/ExpectAnyOf"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect"
        },
        "requires_confirmation": {
          "default": false,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "provenance": {
          "anyOf": [
            {
              "enum": [
                "agent",
                "human"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        }
      },
      "required": [
        "id",
        "intent",
        "action"
      ],
      "title": "CapabilityStep",
      "type": "object"
    },
    "ExpectAnyOf": {
      "properties": {
        "kind": {
          "const": "any_of",
          "default": "any_of",
          "title": "Kind",
          "type": "string"
        },
        "any_of": {
          "items": {
            "discriminator": {
              "mapping": {
                "element_visible": "#/$defs/ExpectElementVisible",
                "text_visible": "#/$defs/ExpectTextVisible",
                "url_matches": "#/$defs/ExpectUrlMatches"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExpectTextVisible"
              },
              {
                "$ref": "#/$defs/ExpectElementVisible"
              },
              {
                "$ref": "#/$defs/ExpectUrlMatches"
              }
            ]
          },
          "title": "Any Of",
          "type": "array"
        }
      },
      "required": [
        "any_of"
      ],
      "title": "ExpectAnyOf",
      "type": "object"
    },
    "ExpectElementVisible": {
      "properties": {
        "kind": {
          "const": "element_visible",
          "default": "element_visible",
          "title": "Kind",
          "type": "string"
