          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "then": {
          "anyOf": [
            {
              "const": "continue",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Then"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        }
      },
      "required": [
        "text"
      ],
      "title": "ExpectTextVisible",
      "type": "object"
    },
    "ExpectUrlMatches": {
      "properties": {
        "kind": {
          "const": "url_matches",
          "default": "url_matches",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
